includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/

    level: 6

    checkModelProperties: true
    checkModelMethodVisibility: true
    checkConfigTypes: true

    treatPhpDocTypesAsCertain: false
